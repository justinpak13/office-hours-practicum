# Copy to .env. These values point oauth2-proxy at the fake Keycloak in ./fake-keycloak.
# The cookie secret and TLS cert live in ./secrets (see init-secrets.sh).

OAUTH2_PROXY_OIDC_ISSUER_URL=http://localhost:8180/realms/staging
OAUTH2_PROXY_CLIENT_ID=dev-officehours
OAUTH2_PROXY_CLIENT_SECRET=fake-keycloak-secret

# Any email in these domains gets in, unless Keycloak says it isn't verified.
OAUTH2_PROXY_EMAIL_DOMAINS=northeastern.edu
