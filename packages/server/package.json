{
  "name": "@koh/server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build --webpack --webpackPath webpack.config.js",
    "dev": "cross-env TYPEORM_LOGGING=true nest build --webpack --webpackPath webpack-hmr.config.js",
    "dev:debug": "nest start --debug --watch",
    "prod:start": "node --max-old-space-size=8192 dist/main",
    "tsc": "tsc",
    "test": "yarn test:unit && yarn test:integration",
    "test:unit": "jest -i",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json -i",
    "dev:db:reset": "yarn typeorm schema:drop",
    "migration:generate": "yarn typeorm schema:drop && yarn typeorm migration:run && yarn typeorm migration:generate",
    "typeorm": "cross-env TYPEORM_CLI=true TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "cli": "nestjs-command"
  },
  "dependencies": {
    "@koh/common": "*",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/integrations": "^5.29.0",
    "@sentry/node": "^5.29.0",
    "@sentry/tracing": "^5.29.0",
    "@sentry/webpack-plugin": "^1.14.0",
    "async": "^3.2.6",
    "axios": "1.21.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6",
    "check-disk-space": "^3.4.0",
    "class-transformer": "0.5.1",
    "connect-redis": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express-session": "^1.19.0",
    "ioredis": "^5.11.1",
    "keyv": "^5",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "morgan": "^1.12.1",
    "multer": "2.4.0",
    "nestjs-command": "^3.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "readline-sync": "^1.4.10",
    "reflect-metadata": "^0.2.0",
    "rimraf": "^6.1.4",
    "rxjs": "^7.0.0",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "typeorm": "^0.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/async": "^3.2.26",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "29.0.0",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/readline-sync": "^1.4.8",
    "@types/supertest": "^2.0.8",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "jest": "29.0.0",
    "prettier": "^2.0.0",
    "run-script-webpack-plugin": "^0.2.3",
    "supertest": "^4.0.2",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ],
      "^.+\\.js$": [
        "babel-jest",
        {
          "rootMode": "upward"
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleDirectories": [
      "<rootDir>/../node_modules",
      "<rootDir>/../../../../node_modules",
      "node_modules",
      "<rootDir>"
    ]
  }
}
